# WebSocket port for MCP browser sync (default: 19283)
# PEEK_A_BIN_WS_PORT=19283

# Where the corpus binaries live, for `npm run corpus` (corpus/README.md).
# Only needed if they are not in one of the conventional locations the harness
# already probes: $XDG_DATA_HOME/peek-a-bin-corpus, ~/.peek-a-bin-corpus, or
# corpus/binaries. Copy this file to .env (gitignored) and set it once per
# machine — a shell export has to be retyped by every new shell and agent.
# The directory holding t32.exe, t64.exe, w64.exe and w32.exe:
# PEEK_CORPUS_DIR=/absolute/path/to/that/directory
