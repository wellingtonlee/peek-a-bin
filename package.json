{
  "name": "peek-a-bin",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-based PE disassembler and decompiler. All analysis client-side via WebAssembly.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wellingtonlee/peek-a-bin.git"
  },
  "homepage": "https://wellingtonlee.github.io/peek-a-bin/",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src",
    "format": "biome format --write",
    "check": "biome check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "corpus": "vitest run --config vitest.corpus.config.ts",
    "corpus:compare": "node corpus/compare.mjs",
    "corpus:comments": "tsx corpus/comments.ts",
    "mcp": "tsx src/mcp/index.ts",
    "mcp:setup": "tsx src/mcp/index.ts setup"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "capstone-wasm": "^1.0.3",
    "tsx": "^4.23.12",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@dagrejs/dagre": "^2.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.0",
    "dompurify": "^3.4.13",
    "marked": "^17.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.18"
  }
}
