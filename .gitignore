# Dependencies
node_modules/

# Production build
dist/

# Agent worktree scratch. CLAUDE.md's "Working in parallel" prescribes <worktree>/.scratch/
# for scratch files, and Tailwind's Vite plugin scans the whole worktree — so a class
# name left in a scratch file leaks a real rule into dist/assets/*.css (measured), and a
# careless `git add` can sweep one into a commit.
.scratch/

# Vite
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# TypeScript
*.tsbuildinfo

# Environment variables
.env
.env.*
!.env.example

# IDE / Editor
.vscode/
.idea/
*.sw?

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Test coverage
coverage/
*.lcov

# Security-sensitive files
*.pem
*.key
*.cert
*.p12
*.pfx
*.jks

# Database files
*.sqlite
*.sqlite3
*.db

# Claude Code
.claude/

# npm pack output
*.tgz

# Beads / Dolt files (added by bd init)
.dolt/
.beads-credential-key
.beads/proxieddb/

# Corpus audit output (npm run corpus)
corpus/artifacts/

# Corpus binaries, if kept in-repo. Third-party executables: NEVER commit them.
# See corpus/README.md — the harness probes this path last.
corpus/binaries/
